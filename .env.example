# Firm lock — Phase 1 only uses wombat. Do not commit real secrets.
FIRM_ID=wombat

# Postgres (prefer AU region when hosting: Neon / Supabase Sydney).
# Local: docker compose up -d  →  postgres://wombat:wombat@localhost:5432/brokerage
# Local `pnpm test` stays on the in-memory store when this is unset.
# CI always sets DATABASE_URL and fails if Postgres list/get regresses.
DATABASE_URL=postgres://wombat:wombat@localhost:5432/brokerage

# Seat / Desk service auth stub. Unset = open (local fixture / Amy without headers).
# When set, every Desk and job route (not /health) requires:
#   Authorization: Bearer <key>   or   X-Api-Key: <key>
# Optional requester stamp: X-Requested-By: seat:andre
DESK_API_KEY=

# Notion CRM write-back (official API). Leave the token blank in repo / CI.
# Adapter fail-closes if token or Opportunity Runs database is missing.
# Local only: NOTION_DRY_RUN=true skips live Notion and still cites sourceRunId.
# Opportunity Runs DB (public id, not a secret):
# https://www.notion.so/541204760e404887b4570ff486ecb205
NOTION_TOKEN=
NOTION_OPPORTUNITY_RUNS_DATABASE_ID=54120476-0e40-4887-b457-0ff486ecb205
NOTION_DRY_RUN=true

# Bitwarden Secrets Manager / machine accounts.
# Never paste portal passwords here or in chat. Tokens stay in the host secret store.
BITWARDEN_API_URL=https://api.bitwarden.com
BITWARDEN_ACCESS_TOKEN=
BITWARDEN_ORGANIZATION_ID=
BITWARDEN_PROJECT_ID=

# Phase 1 fixture path (no live NAB / CoreLogic scrape).
PHASE1_FIXTURES=true

# Process the job in the API process (handy for local fixture demos).
INLINE_WORKER=true

API_HOST=127.0.0.1
API_PORT=3000

# Wombat Desk (apps/web). Unset = stub signed in as Tom.
# If set, the Next app requires this password at /login.
DESK_GATE_PASSWORD=

# Desk data source. Unset = local fixture book (offline default).
# Set to Andre's Phase 1.1 API to read opportunity runs + jobs over HTTP.
# Example: http://127.0.0.1:3000
# Prefix the web command or put this in apps/web/.env.local — Next loads env from apps/web.
DESK_API_BASE_URL=
# Same secret the API checks when DESK_API_KEY is set (Phase 1.2). Unset = no auth headers.
# HttpDeskSource sends Authorization: Bearer <key> on every Desk read.
DESK_API_KEY=
DESK_FIRM_ID=wombat
